# Скопируйте этот файл в .env и впишите токен.
# Токен выдаёт @BotFather: /newbot → имя → ник бота (должен кончаться на bot).
BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Кому приходят заявки — ваш ник без @. Нажмите «Старт» в боте с этого аккаунта.
OWNER_USERNAME=ваш_ник

# Необязательно: id вашего чата (узнать — написать боту /id). Надёжнее ника,
# если когда-нибудь смените ник.
# OWNER_CHAT_ID=

# Сколько дней после заявки человек видит «Вы уже отправили заявку».
# Раньше — если нажмёте «Ответил» под заявкой.
REPEAT_DAYS=7
